{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-rc.1/schemas/semantic-validation-case.schema.json",
  "title": "Agent Volumes Semantic Validation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "cases"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-rc.1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "area", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "area": {
            "type": "string",
            "enum": ["manifest", "release", "trust", "resolver", "warning", "load"]
          },
          "payload": {},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valid"],
            "properties": {
              "valid": { "type": "boolean" },
              "failureCategory": { "type": "string" },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "https://agentvolumes.org/spec/0.1.0-rc.1/schemas/warning.schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
