{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-rc.1/schemas/upstream-baseline.schema.json",
  "title": "Agent Volumes Upstream Validation Baselines",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "baselines"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-rc.1" },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "upstream", "revision", "purpose", "artifacts", "lastReviewed"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "upstream": { "type": "string", "format": "uri" },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "lastReviewed": { "type": "string", "format": "date" },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "oneOf": [
                {
                  "required": ["path"],
                  "properties": { "path": { "type": "string", "minLength": 1 }, "url": true },
                  "not": { "properties": { "url": true }, "required": ["url"] }
                },
                {
                  "required": ["url"],
                  "properties": { "path": true, "url": { "type": "string", "format": "uri" } },
                  "not": { "properties": { "path": true }, "required": ["path"] }
                }
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
