{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-rc.1/schemas/openapi-operation-matrix.schema.json",
  "title": "Agent Volumes OpenAPI Operation Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "endpointFamilies"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-rc.1" },
    "endpointFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "proseAnchor",
          "requirements",
          "auth",
          "operations",
          "expectedProblems"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "const": "checked" },
          "proseAnchor": {
            "type": "string",
            "pattern": "^§[0-9]+(?:\\.[0-9]+)*(?:-§[0-9]+(?:\\.[0-9]+)*)?$"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^AV-BIB-[0-9]{3}$" },
            "uniqueItems": true
          },
          "auth": { "type": "string", "enum": ["Public", "Bearer"] },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operationId", "method", "pathName"],
              "properties": {
                "operationId": { "type": "string", "minLength": 1 },
                "method": { "type": "string", "enum": ["get", "post", "put", "patch", "delete"] },
                "pathName": { "type": "string", "pattern": "^/api/v1/" },
                "successResponse": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "schemaRef"],
                  "properties": {
                    "status": { "type": "string", "pattern": "^2[0-9]{2}$" },
                    "schemaRef": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "uniqueItems": true
          },
          "fixtures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "expectedProblems": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
