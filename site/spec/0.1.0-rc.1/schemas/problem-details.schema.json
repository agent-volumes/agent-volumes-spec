{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-rc.1/schemas/problem-details.schema.json",
  "title": "Agent Volumes Problem Details",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "title", "status"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "https://agentvolumes.org/problems/authentication-required",
        "https://agentvolumes.org/problems/authorization-failed",
        "https://agentvolumes.org/problems/not-found",
        "https://agentvolumes.org/problems/validation-failed",
        "https://agentvolumes.org/problems/invalid-manifest",
        "https://agentvolumes.org/problems/invalid-archive",
        "https://agentvolumes.org/problems/identity-mismatch",
        "https://agentvolumes.org/problems/version-conflict",
        "https://agentvolumes.org/problems/digest-mismatch",
        "https://agentvolumes.org/problems/subject-binding-mismatch",
        "https://agentvolumes.org/problems/inconsistent-registry-state",
        "https://agentvolumes.org/problems/upload-expired",
        "https://agentvolumes.org/problems/missing-uploaded-bytes",
        "https://agentvolumes.org/problems/invalid-upload-state",
        "https://agentvolumes.org/problems/idempotency-conflict",
        "https://agentvolumes.org/problems/payload-too-large",
        "https://agentvolumes.org/problems/unsupported-media-type",
        "https://agentvolumes.org/problems/permission-escalation",
        "https://agentvolumes.org/problems/rate-limited"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "detail": { "type": "string" },
    "instance": { "type": "string", "format": "uri-reference" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/authentication-required" } } },
      "then": { "properties": { "status": { "const": 401 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/authorization-failed" } } },
      "then": { "properties": { "status": { "const": 403 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/not-found" } } },
      "then": { "properties": { "status": { "const": 404 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/validation-failed" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/invalid-manifest" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/invalid-archive" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/identity-mismatch" } } },
      "then": { "properties": { "status": { "const": 409 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/version-conflict" } } },
      "then": { "properties": { "status": { "const": 409 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/digest-mismatch" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/subject-binding-mismatch" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/inconsistent-registry-state" } } },
      "then": { "properties": { "status": { "const": 409 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/upload-expired" } } },
      "then": { "properties": { "status": { "const": 410 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/missing-uploaded-bytes" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/invalid-upload-state" } } },
      "then": { "properties": { "status": { "const": 409 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/idempotency-conflict" } } },
      "then": { "properties": { "status": { "const": 409 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/payload-too-large" } } },
      "then": { "properties": { "status": { "const": 413 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/unsupported-media-type" } } },
      "then": { "properties": { "status": { "const": 415 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/permission-escalation" } } },
      "then": { "properties": { "status": { "const": 400 } } }
    },
    {
      "if": { "properties": { "type": { "const": "https://agentvolumes.org/problems/rate-limited" } } },
      "then": { "properties": { "status": { "const": 429 } } }
    }
  ]
}
