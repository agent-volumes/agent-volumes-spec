{
  "specVersion": "0.1.0-draft.6",
  "canonicalInputFormat": "Each normalized file record is encoded as: file <path> <executable-flag> <byte-length>\\n<content>. Records are sorted lexicographically by normalized path and concatenated directly; byte-length determines where each content payload ends. executable-flag is 1 for executable files and 0 otherwise.",
  "fixtures": [
    {
      "name": "single-file-minimal",
      "normalizedFiles": [
        {
          "path": "volume.toml",
          "executable": false,
          "content": "hello"
        }
      ],
      "canonicalInput": "file volume.toml 0 5\nhello",
      "expectedIntegrity": "sha256:f7e51421b3759bf543486409eed53c8eb4b3a06b840c21b1a72269c835c7f9d1"
    },
    {
      "name": "lexicographic-path-order",
      "normalizedFiles": [
        {
          "path": "agents/review.md",
          "executable": false,
          "content": "agent\n"
        },
        {
          "path": "volume.toml",
          "executable": false,
          "content": "hello"
        }
      ],
      "canonicalInput": "file agents/review.md 0 6\nagent\nfile volume.toml 0 5\nhello",
      "expectedIntegrity": "sha256:193847dcdd04ffbf2a26185b54406001b52b8e6e2ce3102b638534fccbfd5c1c"
    },
    {
      "name": "executable-bit-preserved",
      "normalizedFiles": [
        {
          "path": "scripts/run.sh",
          "executable": true,
          "content": "#!/bin/sh\necho ok\n"
        }
      ],
      "canonicalInput": "file scripts/run.sh 1 18\n#!/bin/sh\necho ok\n",
      "expectedIntegrity": "sha256:ae0d7f0da8f1ac127af0abd7ff409db01f7eef202c09f7b7d8ce051b81dea55f"
    },
    {
      "name": "empty-file-content",
      "normalizedFiles": [
        {
          "path": "empty.txt",
          "executable": false,
          "content": ""
        }
      ],
      "canonicalInput": "file empty.txt 0 0\n",
      "expectedIntegrity": "sha256:9df98c2ebc1150e8de1da65f92d243f2bcfd30e4f013c30fe2ef95f10bc28190"
    },
    {
      "name": "utf8-byte-length",
      "normalizedFiles": [
        {
          "path": "docs/unicode.txt",
          "executable": false,
          "content": "안녕"
        }
      ],
      "canonicalInput": "file docs/unicode.txt 0 6\n안녕",
      "expectedIntegrity": "sha256:2739cda93a5d9e9ef1440e4388c90a7909b53900115ea53989725d493950e2d0"
    },
    {
      "name": "line-ending-preserved",
      "normalizedFiles": [
        {
          "path": "docs/crlf.txt",
          "executable": false,
          "content": "line\r\nnext\n"
        }
      ],
      "canonicalInput": "file docs/crlf.txt 0 11\nline\r\nnext\n",
      "expectedIntegrity": "sha256:e7fedb3fc99b259f6f8bb1a3dc2ee2714beb3009579e177e8a0ea4a0f0b6ba3f"
    },
    {
      "name": "mixed-executable-order",
      "normalizedFiles": [
        {
          "path": "bin/tool.sh",
          "executable": true,
          "content": "echo ok\n"
        },
        {
          "path": "lib/helper.txt",
          "executable": false,
          "content": "helper"
        }
      ],
      "canonicalInput": "file bin/tool.sh 1 8\necho ok\nfile lib/helper.txt 0 6\nhelper",
      "expectedIntegrity": "sha256:d79cb68b4fadba6e2063bc1106fe3b401ba7f9fc68a234186f8c50cc5803f345"
    },
    {
      "name": "generated-file-included",
      "normalizedFiles": [
        {
          "path": "dist/generated.json",
          "executable": false,
          "content": "{\"ok\":true}\n"
        }
      ],
      "canonicalInput": "file dist/generated.json 0 12\n{\"ok\":true}\n",
      "expectedIntegrity": "sha256:c99c5bb81b8f614ef3118143eb6f32941f35da2d45ee3a4ca3e93ba119f5bbe8"
    },
    {
      "name": "binary-byte-content",
      "normalizedFiles": [
        {
          "path": "bin/blob.dat",
          "executable": false,
          "contentBase64": "AP9B"
        }
      ],
      "canonicalInputBase64": "ZmlsZSBiaW4vYmxvYi5kYXQgMCAzCgD/QQ==",
      "expectedIntegrity": "sha256:cb1cdaee35844f18e8313f5213e1826186c3694a6aebc1c67bcdc12a7c5218ca"
    }
  ]
}
