{
  "description": "Capability metadata with invalid compatibility version fields that must fail schema validation.",
  "fixtures": [
    {
      "name": "compatible-spec-versions-must-be-array",
      "canonicalParsedData": {
        "schemaVersion": "1",
        "specVersion": "0.1.0-draft.6",
        "compatibleSpecVersions": ">=0.1.0-draft.6 <0.2.0",
        "apiVersion": "v1",
        "scopePolicy": {
          "scopesSupported": true,
          "scopelessSupported": true,
          "scopesRequired": false
        },
        "deliveryModes": ["cdn"],
        "apis": {
          "trustMetadata": true,
          "versionIndex": true,
          "releaseUploads": true,
          "trustUploads": true,
          "advisories": true
        },
        "uploadProfiles": {
          "releaseUploads": ["http-put"],
          "trustUploads": ["http-put"]
        }
      },
      "expected": {
        "valid": false,
        "failureCategory": "invalid-compatible-spec-versions"
      }
    },
    {
      "name": "compatible-spec-version-items-must-be-exact-versions",
