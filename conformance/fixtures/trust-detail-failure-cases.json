{
  "specVersion": "0.1.0-rc.1",
  "description": "Trust detail Problem Details failure cases for portable Agent Volumes bibliothecas.",
  "fixtures": [
    {
      "name": "trust-detail-release-not-found",
      "endpoint": "GET /api/v1/volumes/{name}/{version}/trust/detail",
      "schema": "problem-details",
      "expected": { "failureCategory": "not-found" },
      "payload": {
        "type": "https://agentvolumes.org/problems/not-found",
        "title": "Release not found",
        "status": 404,
        "detail": "Trust detail metadata is unavailable because the release does not exist or is not visible."
      }
    },
    {
      "name": "trust-detail-inconsistent-registry-state",
      "endpoint": "GET /api/v1/volumes/{name}/{version}/trust/detail",
      "schema": "problem-details",
      "expected": { "failureCategory": "inconsistent-registry-state" },
      "payload": {
        "type": "https://agentvolumes.org/problems/inconsistent-registry-state",
        "title": "Inconsistent registry state",
        "status": 409,
        "detail": "Trust detail metadata cannot be reconciled with the release identity."
      }
    },
    {
      "name": "trust-detail-rate-limited",
      "endpoint": "GET /api/v1/volumes/{name}/{version}/trust/detail",
      "schema": "problem-details",
      "expected": { "failureCategory": "rate-limited" },
      "payload": {
        "type": "https://agentvolumes.org/problems/rate-limited",
        "title": "Rate limited",
        "status": 429,
        "detail": "The trust detail request was rate limited."
      }
    },
    {
      "name": "scoped-trust-detail-release-not-found",
      "endpoint": "GET /api/v1/volumes/@{scope}/{name}/{version}/trust/detail",
      "schema": "problem-details",
      "expected": { "failureCategory": "not-found" },
      "payload": {
        "type": "https://agentvolumes.org/problems/not-found",
        "title": "Release not found",
        "status": 404,
        "detail": "Scoped trust detail metadata is unavailable because the release does not exist or is not visible."
      }
    },
    {
      "name": "scoped-trust-detail-inconsistent-registry-state",
      "endpoint": "GET /api/v1/volumes/@{scope}/{name}/{version}/trust/detail",
      "schema": "problem-details",
      "expected": { "failureCategory": "inconsistent-registry-state" },
      "payload": {
        "type": "https://agentvolumes.org/problems/inconsistent-registry-state",
        "title": "Inconsistent registry state",
        "status": 409,
        "detail": "Scoped trust detail metadata cannot be reconciled with the release identity."
      }
    },
    {
      "name": "scoped-trust-detail-rate-limited",
      "endpoint": "GET /api/v1/volumes/@{scope}/{name}/{version}/trust/detail",
      "schema": "problem-details",
      "expected": { "failureCategory": "rate-limited" },
      "payload": {
        "type": "https://agentvolumes.org/problems/rate-limited",
        "title": "Rate limited",
        "status": 429,
        "detail": "The scoped trust detail request was rate limited."
      }
    }
  ]
}
