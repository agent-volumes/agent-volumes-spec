{
  "scripts": {
    "build:site:openapi": "bun scripts/build-site-openapi.mjs",
    "build:site:schemas": "bun scripts/build-site-schemas.mjs",
    "changelog:check": "scripts/update-changelog.sh --check",
    "changelog:print": "scripts/update-changelog.sh --print",
    "changelog:update": "scripts/update-changelog.sh",
    "prepare": "lefthook install",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\" \"**/*.mdc\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"**/*.mdx\" \"**/*.mdc\"",
    "lint:openapi": "redocly lint openapi/bibliotheca.openapi.yaml",
    "lint:oxlint": "oxlint --quiet --no-error-on-unmatched-pattern",
    "lint:site": "bun run --cwd site lint",
    "site:dev": "bun run --cwd site dev",
    "format": "git ls-files \"*.md\" \"*.mdx\" \"*.json\" \"*.yaml\" \"*.yml\" \"*.js\" \"*.jsx\" \"*.mjs\" \"*.cjs\" \"*.ts\" \"*.tsx\" \"*.mts\" \"*.cts\" \"*.mdc\" | xargs prettier --write",
    "format:check": "git ls-files \"*.md\" \"*.mdx\" \"*.json\" \"*.yaml\" \"*.yml\" \"*.js\" \"*.jsx\" \"*.mjs\" \"*.cjs\" \"*.ts\" \"*.tsx\" \"*.mts\" \"*.cts\" \"*.mdc\" | xargs prettier --check",
    "format:files": "prettier --write",
    "lint:md:fix:files": "markdownlint-cli2 --fix",
    "release:changelog": "scripts/update-changelog.sh --tag",
    "release:tag": "scripts/create-release-tag.sh",
    "validate:artifacts": "bun scripts/validate-artifacts.mjs"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^0.9.4",
    "@redocly/cli": "^2.30.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.6",
    "markdownlint-cli2": "^0.22.1",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "protobufjs": "7.5.8"
  }
}
