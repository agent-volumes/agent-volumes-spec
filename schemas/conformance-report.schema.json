{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-draft.5/schemas/conformance-report.schema.json",
  "title": "Agent Volumes Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "runner", "implementation", "summary", "results"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-draft.5" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["client", "bibliotheca", "validator", "exporter", "harness"] },
          "uniqueItems": true
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "total", "passed", "failed", "skipped"],
      "properties": {
        "outcome": { "type": "string", "enum": ["pass", "fail"] },
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fixture", "area", "outcome"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable result identifier, derived from the fixture path and case name where applicable.",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "fixture": { "type": "string", "minLength": 1 },
          "case": { "type": "string", "minLength": 1 },
          "area": {
            "type": "string",
            "enum": [
              "manifest",
              "digest",
              "archive",
              "identity",
              "resolver",
              "release-metadata",
              "release-upload",
              "trust-discovery",
              "trust-upload",
              "trust-verification",
              "advisory",
              "capability",
              "mapping",
              "problem-details",
              "warning",
              "openapi"
            ]
          },
          "outcome": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "failureCategory": { "type": "string" },
          "message": { "type": "string" },
          "warnings": {
            "type": "array",
            "items": { "$ref": "https://agentvolumes.org/spec/0.1.0-draft.5/schemas/warning.schema.json" }
          }
        }
      }
    }
  }
}
