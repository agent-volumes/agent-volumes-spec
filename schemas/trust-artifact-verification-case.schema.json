{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-draft.6/schemas/trust-artifact-verification-case.schema.json",
  "title": "Agent Volumes Trust Artifact Verification Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "cases"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-draft.6" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "format", "subject", "artifactSubject", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["bom", "provenance", "signature"] },
          "format": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "mediaType"],
            "properties": {
              "family": { "type": "string" },
              "mediaType": { "type": "string" },
              "predicateType": { "type": "string", "format": "uri" },
              "signatureFormat": { "type": "string" },
              "version": { "type": "string" }
            }
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["purl", "integrity"],
            "properties": {
              "purl": {
                "type": "string",
                "pattern": "^pkg:volume/(?:%40(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/)?(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
              },
              "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          },
          "artifactSubject": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purl": {
                "type": "string",
                "pattern": "^pkg:volume/(?:%40(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/)?(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
              },
              "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "predicateType": { "type": "string", "format": "uri" },
              "signatureFormat": { "type": "string" }
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mediaType", "bytesBase64", "artifactDigest"],
            "properties": {
              "mediaType": { "type": "string" },
              "bytesBase64": { "type": "string", "contentEncoding": "base64" },
              "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          },
          "lifecycleStatus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": {
              "state": { "type": "string", "enum": ["active", "revoked", "superseded", "invalid"] },
              "reason": { "type": "string" }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valid"],
            "properties": {
              "valid": { "type": "boolean" },
              "failureCategory": {
                "type": "string",
                "enum": [
                  "subject-binding-mismatch",
                  "unsupported-provenance-predicate",
                  "unsupported-signature-format",
                  "revoked-trust-artifact",
                  "invalid-trust-artifact",
                  "stale-trust-evidence-only",
                  "insufficient-current-trust-evidence",
                  "missing-artifact-subject",
                  "unsupported-artifact-format"
                ]
              }
            }
          }
        }
      }
    }
  }
}
