{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-rc.1/schemas/purl-vers-compatibility-exceptions.schema.json",
  "title": "Agent Volumes PURL/VERS Compatibility Exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "exceptions"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-rc.1" },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purlType", "versScheme", "source", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
          "purlType": { "type": "string", "pattern": "^[a-z][a-z0-9.+-]*$" },
          "versScheme": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "source": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
