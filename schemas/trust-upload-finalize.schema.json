{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-draft.5/schemas/trust-upload-finalize.schema.json",
  "title": "Agent Volumes Trust Upload Finalize Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["uploadId", "attachmentId", "subject", "status", "detailUrl"],
  "properties": {
    "uploadId": { "type": "string", "minLength": 1 },
    "attachmentId": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purl", "integrity"],
      "properties": {
        "purl": {
          "type": "string",
          "pattern": "^pkg:volume/.+@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["active", "revoked", "superseded", "invalid"] },
        "reason": { "type": "string" }
      }
    },
    "detailUrl": { "type": "string", "format": "uri-reference" }
  }
}
