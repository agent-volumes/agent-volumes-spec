{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-draft.6/schemas/component-dependency-validation-case.schema.json",
  "title": "Agent Volumes Component Dependency Validation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "cases"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-draft.6" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "declaredComponents",
          "volume-dependencies",
          "component-dependencies",
          "resolvedComponents",
          "expected"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "declaredComponents": {
            "type": "array",
            "items": { "$ref": "#/$defs/componentName" },
            "uniqueItems": true
          },
          "volume-dependencies": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/volumeDependencyName" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "component-dependencies": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/componentName" },
            "additionalProperties": {
              "type": "array",
              "items": { "$ref": "#/$defs/componentPurlCandidate" }
            }
          },
          "resolvedComponents": {
            "type": "array",
            "items": { "$ref": "#/$defs/componentPurl" },
            "uniqueItems": true
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valid"],
            "properties": {
              "valid": { "type": "boolean" },
              "failureCategory": {
                "type": "string",
                "enum": [
                  "missing-component-dependency",
                  "unknown-local-component",
                  "invalid-component-purl",
                  "missing-parent-volume-dependency"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "componentName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
    },
    "volumeDependencyName": {
      "type": "string",
      "pattern": "^(?:@(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/)?(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
    },
    "componentPurlCandidate": {
      "type": "string",
      "pattern": "^pkg:volume/"
    },
    "componentPurl": {
      "type": "string",
      "pattern": "^pkg:volume/(?:%40(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/)?(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?(?:@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)?#(agent|skill|command|tool|hook|mcp-server|lsp-server)/(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
    }
  }
}
