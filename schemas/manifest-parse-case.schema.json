{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvolumes.org/spec/0.1.0-draft.6/schemas/manifest-parse-case.schema.json",
  "title": "Agent Volumes Authored Manifest Parse Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "cases"],
  "properties": {
    "specVersion": { "type": "string", "const": "0.1.0-draft.6" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "authoredToml", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "authoredToml": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valid"],
            "properties": {
              "valid": { "type": "boolean" },
              "canonicalParsedData": { "type": "object" },
              "failureCategory": { "type": "string" },
              "path": { "type": "string" },
              "warnings": {
                "type": "array",
                "items": { "$ref": "https://agentvolumes.org/spec/0.1.0-draft.6/schemas/warning.schema.json" }
              }
            }
          }
        }
      }
    }
  }
}
